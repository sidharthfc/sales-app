# Copy to .env.local and fill in. Never commit real values.

# Leave blank in dev to use the Vite proxy (see vite.config.js) against localhost:8000.
# Set to the deployed Frappe site origin for production builds, e.g. https://lmntrix.co
VITE_API_BASE_URL=

# Google Maps JS API key (used on admin tracking/routes screens). Get from the project owner.
VITE_GOOGLE_MAPS_KEY=
